/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Not(in=sel , out=notSel );
    And(a=a , b=notSel , out=and1 );
    And(a=b , b=sel , out=and2 );
    Or(a=and1 , b=and2 , out=out );
}