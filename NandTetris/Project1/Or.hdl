/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 * Nand(a, b) = Not(a And b)
 * Or = Not(NotA and NotB)
 */
CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Not(in=a , out=notA );
    Not(in=b , out=notB );
    Nand(a=notA , b=notB , out=out );
}